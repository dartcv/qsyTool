# Copy this file to deploy/.env and replace the example host names.
COMPOSE_PROJECT_NAME=qsy
QSY_API_DOMAIN=api.example.com
QSY_API_IMAGE=qsy-resolver-api:local

# Keep this in sync with the container's exposed port and Caddy upstream.
QSY_API_BIND_ADDR=0.0.0.0:18082
QSY_API_REQUEST_TIMEOUT_SECS=20
QSY_API_BODY_LIMIT_BYTES=65536
QSY_API_MAX_IN_FLIGHT=64
QSY_API_CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
QSY_API_LOG_FORMAT=json
RUST_LOG=qsy_resolver_api=info,tower_http=info
